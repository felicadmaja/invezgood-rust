# Server gRPC
HOST=0.0.0.0
GRPC_PORT=50054
ENABLE_COMPRESSION=true

# TLS gRPC (sertifikat dari project mrgs)
USE_TLS=true
TLS_CERT_DIR=/home/baki1/mrgs/crate/certificate
TLS_CERT_FILE=_.mariban.com_chain.crt
TLS_KEY_FILE=_.mariban.com.key

# ScyllaDB
SCYLLA_URI=127.0.0.1:9042
SCYLLA_USER=cassandra
SCYLLA_PASSWORD=
SCYLLA_KEYSPACE=invezgood

# Invezgo API & MCP (Cursor: .cursor/mcp.json)
INVEZGO_BEARER_TOKEN=

# Redis (cache StockListUpdatedAt + Stockbit readiness)
REDIS_URL=redis://127.0.0.1:6379

# Yahoo spike poller (persen close vs open; 8 = 8%)
UP_SPIKE_PERCENTAGE=8
DOWN_SPIKE_PERCENTAGE=6
JEDA_MS_ANTAR_EMITEN=25
INTERVAL_YAHOO_SPIKE_POLL_SECS=120

# Stockbit browser scrape (portofolio / pending_order)
STOCKBIT_EMAIL=
STOCKBIT_PASSWORD=
STOCKBUT_PIN=
# STOCKBIT_PIN=
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium-browser
# STOCKBIT_BROWSER_DATA_DIR=/path/to/browser_data
# STOCKBIT_2FA_TIMEOUT_SECS=300
# STOCKBIT_READY_POLL_MIN_SECS=540
# STOCKBIT_READY_POLL_MAX_SECS=600
