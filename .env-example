# Opsional: path executable Chrome/Chromium
CHROME_EXECUTABLE_PATH=

# Credential login Stockbit — https://stockbit.com/login
STOCKBIT_EMAIL=
STOCKBIT_PASSWORD=
STOCKBUT_PIN=
# STOCKBIT_PIN=

# Interval poller IsStockbitReady (detik). Default kode: 240–300 (4–5 menit).
STOCKBIT_READY_POLL_MIN_SECS=240
STOCKBIT_READY_POLL_MAX_SECS=300

# Setelah restart/build: true = langsung auto-scrape saat cek ready pertama (default).
# false = skip scrape siklus pertama; tunggu interval poller berikutnya (25–30 menit jika env di atas).
# Alias typo: NEW_BUILD_LANNGSUNG_SCRAPE juga dibaca.
NEW_BUILD_LANGSUNG_SCRAPE=true

# Opsional: timeout tunggu approve 2FA di HP (detik). Default 300.
# STOCKBIT_2FA_TIMEOUT_SECS=300

# ScyllaDB
SCYLLA_URI=127.0.0.1:9042
SCYLLA_USER=
SCYLLA_PASSWORD=
SCYLLA_KEYSPACE=stockbit

# gRPC
GRPC_PORT=50054

# TLS gRPC — sertifikat dari folder certificate
USE_TLS=true
TLS_CERT_DIR=
TLS_CERT_FILE=
TLS_KEY_FILE=

# Redis (long_name cache + IsStockbitReady state key `stockbit:readiness`)
REDIS_URL=redis://localhost:6379

# JWT (HS256)
JWT_SECRET=
JWT_EXPIRY_SECS=86400

# Google Cloud Storage (icon emiten → modul `stoksaham`)
GCS_BUCKET=
GCS_SERVICE_ACCOUNT_JSON=
GCS_SIGNED_URL_EXPIRES_SECS=6000
GCS_PREVIEW_URL_EXPIRES_SECS=604800
GCS_MAX_FOTO_SIZE_BYTES=5000000
GCS_MAX_VIDEO_SIZE_BYTES=50000000
