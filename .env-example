# Server gRPC
HOST=0.0.0.0
GRPC_PORT=50054
ENABLE_COMPRESSION=true

# TLS gRPC (sertifikat dari project mrgs)
USE_TLS=true
TLS_CERT_DIR=/home/baki1/mrgs/crate/certificate
TLS_CERT_FILE=_.mariban.com_chain.crt
TLS_KEY_FILE=_.mariban.com.key

# ScyllaDB
SCYLLA_URI=127.0.0.1:9042
SCYLLA_USER=cassandra
SCYLLA_PASSWORD=
SCYLLA_KEYSPACE=invezgood

# Invezgo API & MCP (Cursor: .cursor/mcp.json)
INVEZGO_BEARER_TOKEN=

# Redis (cache StockListUpdatedAt)
REDIS_URL=redis://127.0.0.1:6379
