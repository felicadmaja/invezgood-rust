# Opsional: path executable Chrome/Chromium
CHROME_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Credential login Stockbit — https://stockbit.com/login
STOCKBIT_EMAIL=
STOCKBIT_PASSWORD=

# Opsional: timeout tunggu approve 2FA di HP (detik). Default 300.
# STOCKBIT_2FA_TIMEOUT_SECS=300

# ScyllaDB
SCYLLA_URI=127.0.0.1:9042
SCYLLA_USER=
SCYLLA_PASSWORD=
SCYLLA_KEYSPACE=stockbit

# gRPC portofolio service (default 50054) — wajib JWT
GRPC_PORT=50054

# gRPC user service Login (default 50055)
USER_GRPC_PORT=50055

# JWT shared secret (HS256) — wajib sama di semua crate yang validasi token
JWT_SECRET=change-me-stockbit-jwt-secret
# JWT_EXPIRY_SECS=86400
