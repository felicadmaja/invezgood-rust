#Invezgo spike
UP_SPIKE_PERCENTAGE=8
DOWN_SPIKE_PERCENTAGE=6
JEDA_MS_ANTAR_EMITEN=10
INTERVAL_YAHOO_SPIKE_POLL_SECS=600
INTERVAL_INVEZGO_SPIKE_POLL_SECS=600



OPENING_UP_SPIKE_PERCENTAGE=6
OPENING_DOWN_SPIKE_PERCENTAGE=4

# Hari libur nasional dibaca dari Scylla invezgood.hari_libur (RPC HariLibur), bukan dari .env


# Opsional: path executable Chrome/Chromium
CHROME_EXECUTABLE_PATH=/usr/bin/chromium-browser


# Credential login Stockbit — https://stockbit.com/login
STOCKBIT_EMAIL=felic_admaja@yahoo.com
STOCKBIT_PASSWORD=Stockbit@123456
#STOCKBUT_PIN=xxxxxx
STOCKBIT_READY_POLL_MIN_SECS=1800
STOCKBIT_READY_POLL_MAX_SECS=3600
MAX_HISTORICAL_MONTHS_DEFAULT=180


SCYLLA_URI=127.0.0.1:9042
SCYLLA_USER=cassandra
SCYLLA_PASSWORD='I<0%i9@qJ^-Ms@&SqP89^'
SCYLLA_KEYSPACE=invezgood

GRPC_PORT=50054

# Keepalive & lifecycle HTTP/2 server gRPC
# 0 = nonaktif layer tersebut
GRPC_TCP_KEEPALIVE_SECS=30
GRPC_HTTP2_KEEPALIVE_INTERVAL_SECS=30
GRPC_HTTP2_KEEPALIVE_TIMEOUT_SECS=10
# GOAWAY graceful bila koneksi idle (tanpa RPC); default 300s (5 menit)
GRPC_HTTP2_MAX_CONNECTION_IDLE_SECS=300
# Umur maks koneksi sebelum GOAWAY + renegotiasi (0 = nonaktif)
# GRPC_HTTP2_MAX_CONNECTION_AGE_SECS=0
# Grace setelah age GOAWAY sebelum force-close (default 30s bila age aktif)
# GRPC_HTTP2_MAX_CONNECTION_AGE_GRACE_SECS=30
# PING keepalive meski tidak ada RPC aktif (hyper default true bila ping interval aktif)
GRPC_HTTP2_PERMIT_KEEPALIVE_WITHOUT_CALLS=true

# TLS gRPC — sertifikat dari folder certificate mrgs
USE_TLS=true
TLS_CERT_DIR=/etc/ssl/mariban
TLS_CERT_FILE=_.mariban.com_chain.crt
TLS_KEY_FILE=_.mariban.com.key

#REDIS
REDIS_URL=redis://localhost:6379


JWT_SECRET=change-me-invezgood-jwt-secret
JWT_EXPIRY_SECS=86400

# Google Cloud Storage (icon emiten → modul `stoksaham`)
GCS_BUCKET=mariban_bucket
GCS_SERVICE_ACCOUNT_JSON=/home/baki1/mrgs/mariban-com-e85333ffe278.json
GCS_SIGNED_URL_EXPIRES_SECS=6000
GCS_PREVIEW_URL_EXPIRES_SECS=604800
GCS_MAX_FOTO_SIZE_BYTES=5000000
GCS_MAX_VIDEO_SIZE_BYTES=50000000


INVEZGO_BEARER_TOKEN=invz_live_9f2a1b2bb2723da270a87b41747e880801026d469b124fd37f051a9b2320ce95
# Rate limit Invezgo: 500 req/menit, request paralel OK (token bucket).
INVEZGO_MAX_REQ_PER_MINUTE=500
# Burst awal: berapa request paralel langsung jalan sebelum throttle (~chart+bandarmology+foreign).
INVEZGO_BURST=20
# Retry bila HTTP 429.
INVEZGO_429_MAX_RETRIES=3
INVEZGO_429_BACKOFF_MS=2000
INVEZGO_429_COOLDOWN_SECS=10